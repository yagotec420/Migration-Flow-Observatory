# Ambiente
NODE_ENV=development

# Servidor
PORT=3333
API_VERSION=v1

# Banco de dados (preparado para a Etapa 3 — não utilizado enquanto o provider for Mock)
DATABASE_URL="postgresql://user:password@localhost:5432/migration_flow_observatory?schema=public"

# Mapas (consumido pelo frontend, mantido aqui como referência de contrato de ambiente)
MAPBOX_TOKEN=

# Logs
LOG_LEVEL=info

# CORS (origens permitidas, separadas por vírgula)
CORS_ALLOWED_ORIGINS=http://localhost:5173

# Rate limit
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX_REQUESTS=100
