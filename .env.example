# ──────────────────────────────────────────────────────────────
# Migration Flow Observatory — Variáveis de ambiente (infraestrutura)
# ──────────────────────────────────────────────────────────────
# Usadas por docker-compose.yml (na raiz) para subir o PostgreSQL + PostGIS.
# O backend (backend/.env.example) e o módulo de banco (database/.env.example)
# têm suas próprias cópias de DATABASE_URL — mantenha os três sincronizados.

POSTGRES_USER=migration_user
POSTGRES_PASSWORD=CHANGE_ME
POSTGRES_DB=migration_flow_observatory
POSTGRES_PORT=5432

DATABASE_URL="postgresql://migration_user:CHANGE_ME@localhost:5432/migration_flow_observatory?schema=public"
